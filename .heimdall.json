{
  "$schema": "schemas/heimdall.schema.json",
  "root": true,
  "suppressions": true,
  "doc": {
    "scope": "public"
  },
  "rules": {
    "cpp/no-null": "warning",
    "format/no-trailing-whitespace": "warning",
    "format/require-final-newline": "warning",
    "api/const-correctness": "warning",
    "cpp/no-empty-catch": "warning",
    "cpp/no-duplicate-include": "warning",
    "cpp/sort-includes": "warning",
    "cpp/modernize-using": "warning",
    "doc/require-comment": "warning",
    "doc/doxygen-style": "warning",
    "cpp/constant-naming": "warning"
  },
  "format": {
    "sort-includes": true,
    "use-tabs": true,
    "column-limit": 100,
    "pointer-alignment": "left",
    "reference-alignment": "left",
    "align-consecutive-assignments": true,
    "align-consecutive-macros": true
  },
  "naming": {
    "constants": "screaming-snake-case"
  },
  "include-order": {
    "groups": [
      "angle",
      "quote"
    ],
    "case-insensitive": true
  }
}