{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heimdall configuration",
  "description": "Configuration file for Heimdall (.heimdall.json). Validated by heimdall init and loaded by heimdall lint/check and heimdall-lsp.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema URI used by editors for completion and validation."
    },
    "root": {
      "type": "boolean",
      "default": false,
      "description": "When true, stop searching parent directories for additional configs."
    },
    "suppressions": {
      "type": "boolean",
      "default": true,
      "description": "When false, // heimdall-suppress comments are ignored."
    },
    "rules": {
      "type": "object",
      "description": "Per-rule severity. Valid values are 'off', 'warning' and 'error'.",
      "properties": {
        "cpp/no-null": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "format/no-trailing-whitespace": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "format/require-final-newline": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/no-empty-catch": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/no-duplicate-include": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-using": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-override": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-nullptr": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/no-zero-as-null": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-auto": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/no-implicit-bool-conversion": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-range-loop": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-loop-convert": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/include-what-you-use": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-final": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-const": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-constexpr": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-emplace": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-make-unique": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-make-shared": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-smart-ptr": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/no-new-delete": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-span": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-string-view": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-algorithms": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-structured-bindings": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-attributes": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/modernize-consteval-constexpr": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "api/virtual-destructor": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "api/missing-nodiscard": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "api/pass-by-value": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "api/pass-by-const-reference": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "api/const-correctness": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "api/unsafe-downcast": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "api/slicing": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "api/implicit-conversion": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "api/explicit-constructor": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "api/overload-hiding": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "api/virtual-call-in-constructor": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "doc/require-comment": {
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "description": "Opt-in. Public classes, enums and functions need a Doxygen comment. See 'doc.scope'."
        },
        "doc/doxygen-style": {
          "enum": [
            "off",
            "warning",
            "error"
          ],
          "description": "Opt-in. Doxygen comments need @brief, @param, @tparam, @return and @throws, one-sentence briefs and Javadoc style. See 'doc.scope'."
        },
        "cpp/no-integer-to-pointer": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/designated-init-order": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/no-unused-include": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/prefer-forward-declaration": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/no-circular-include": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/sort-includes": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/no-todo": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        },
        "cpp/no-magic-numbers": {
          "enum": [
            "off",
            "warning",
            "error"
          ]
        }
      },
      "additionalProperties": {
        "enum": [
          "off",
          "warning",
          "error"
        ],
        "description": "Allows future rules while still validating the setting value."
      }
    },
    "include-order": {
      "type": "object",
      "description": "Group order used by cpp/sort-includes. The rule only runs when enabled in 'rules'.",
      "properties": {
        "groups": {
          "type": "array",
          "description": "Ordered include groups. Must list both 'angle' and 'quote'.",
          "items": {
            "enum": [
              "angle",
              "quote"
            ]
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "case-insensitive": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "groups"
      ],
      "additionalProperties": false
    },
    "doc": {
      "type": "object",
      "description": "Options of the doc/* rules.",
      "properties": {
        "scope": {
          "enum": [
            "public",
            "private",
            "all"
          ],
          "default": "public",
          "description": "Which declarations are checked: 'public' (public and protected members, namespace-scope entities with external linkage), 'private' (private members, static and anonymous-namespace entities) or 'all'."
        }
      },
      "additionalProperties": false
    },
    "format": {
      "type": "object",
      "description": "Formatter settings. CLI alignment flags override the corresponding values.",
      "properties": {
        "pointer-alignment": {
          "enum": [
            "left",
            "right"
          ],
          "default": "left",
          "description": "Attachment of declarator `*`: 'left' formats `int* x`, 'right' formats `int *x`."
        },
        "reference-alignment": {
          "enum": [
            "left",
            "right"
          ],
          "default": "left",
          "description": "Attachment of declarator `&`/`&&`: 'left' formats `int& x`, 'right' formats `int &x`."
        },
        "blank-line-between-methods": {
          "type": "boolean",
          "default": true,
          "description": "Separate function/method declarations and definitions with blank lines. In records, also separate fields, methods and access sections; consecutive fields stay grouped. Documentation stays attached."
        },
        "max-parameters-per-line": {
          "type": "integer",
          "minimum": 0,
          "default": 3,
          "description": "More than this many declared parameters: put one parameter per line after '('. Zero disables this rule."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
